        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  direction TB\n\n  class User {\n    -userId: int\n    -name: String\n    -email: String\n    -password: String\n    -role: String\n    +login()\n    +logout()\n  }\n\n  class Student {\n    -regNo: String\n    -phone: String\n    +bookMeal()\n    +cancelMeal()\n    +submitComplaint()\n    +viewMonthlyBill()\n    +viewRoomDetails()\n  }\n\n  class Warden {\n    -employeeId: String\n    +manageStudents()\n    +allocateRoom()\n    +setMealRate()\n    +generateReports()\n  }\n\n  class MessStaff {\n    -staffId: String\n    +viewMeal()\n  }\n\n  class Room {\n    -roomId: int\n    -roomNumber: String\n    -capacity: int\n    -occupiedCount: int\n    +isVacant(): boolean\n  }\n\n  class MealBooking {\n    -bookingId: int\n    -date: Date\n    -mealType: String\n    -mealRate: float\n    -status: String\n    +cancelBooking()\n  }\n\n  class Complaint {\n    -complaintId: int\n    -description: String\n    -status: String\n    -date: Date\n    +getStatus()\n  }\n\n  class Bill {\n    -billId: int\n    -month: String\n    -totalMeals: int\n    -totalAmount: float\n    +calculateBill(): float\n  }\n\n  User &lt;|-- Student\n  User &lt;|-- Warden\n  User &lt;|-- MessStaff\n\n  Student \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MealBooking : makes\n  Student \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Complaint : submits\n  Student \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Bill : receives\n  Room \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Student : assigned to\n  Warden \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Room : allocates\n  Warden \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Student : manages\n  MessStaff ..&gt; MealBooking : views\n  Bill ..&gt; MealBooking : calculated from\n\n  style User fill:#ffffff,stroke:#000000,stroke-width:1px\n  style Student fill:#ffffff,stroke:#000000,stroke-width:1px\n  style Warden fill:#ffffff,stroke:#000000,stroke-width:1px\n  style MessStaff fill:#ffffff,stroke:#000000,stroke-width:1px\n  style Room fill:#ffffff,stroke:#000000,stroke-width:1px\n  style MealBooking fill:#ffffff,stroke:#000000,stroke-width:1px\n  style Complaint fill:#ffffff,stroke:#000000,stroke-width:1px\n  style Bill fill:#ffffff,stroke:#000000,stroke-width:1px&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ytTqfuVvTbCGxFGGBJHd-2">
